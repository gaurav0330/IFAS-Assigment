      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ifas.app"
    },
    "web": {
      "favicon": "./assets/ifas_edutech_pvt_ltd_logo.jpg"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
